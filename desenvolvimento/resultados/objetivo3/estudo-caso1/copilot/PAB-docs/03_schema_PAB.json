    "DT_ATUALIZACAO_ETL": { "type": ["string", "null"], "format": "date-time", "description": "Timestamp da carga ETL." },
    "NM_ARQUIVO": { "type": ["string", "null"], "maxLength": 256, "description": "Arquivo origem no padrão PAB." },
    "ANO_MES_REF": { "type": ["integer", "null"], "description": "Competência de referência em AAAAMM." }
